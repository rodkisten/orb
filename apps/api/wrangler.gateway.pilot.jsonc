{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orb-preview-gateway",
  "main": "src/previews/gateway.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "routes": [{ "pattern": "sandbox-pr15.migos.club", "custom_domain": true }],
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "ORB_DB",
      "database_name": "orb-events",
      "database_id": "103adc47-28f5-4774-972a-002a7ffcd9a8",
    },
  ],
}
