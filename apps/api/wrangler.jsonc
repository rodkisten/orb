{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orb-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "api.orb.migos.club", "custom_domain": true }],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "d1_databases": [
    {
      "binding": "ORB_DB",
      "database_name": "orb-events",
      "database_id": "103adc47-28f5-4774-972a-002a7ffcd9a8",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "queues": {
    "producers": [{ "binding": "ORB_EVENTS", "queue": "orb-events" }],
    "consumers": [{ "queue": "orb-events", "max_batch_size": 10, "max_retries": 5, "dead_letter_queue": "orb-events-dlq" }]
  }
}
