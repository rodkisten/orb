{
  "name": "orb-web",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "orb.migos.club",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/v1",
      "/v1/*"
    ]
  },
  "main": "worker.ts",
  "services": [
    {
      "binding": "API",
      "service": "orb-api"
    }
  ]
}
